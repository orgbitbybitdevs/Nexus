const byId = Object.fromEntries(resources.map((resource) => [resource.id, resource]));
const profileDefinitions: Array<{ id: ProfileId; icon: string; title: string; description: string; objective: string; resourceIds: string[] }> = [
  {
    id: 'start',
    icon: '?',
    title: l({ es: 'No se que estudiar', en: 'I do not know what to study', zh: '还不知道学什么' }),
