    description: l({ es: 'Convierte ideas en propuestas visuales, prototipos y proyectos presentables.', en: 'Turn ideas into visual proposals, prototypes and presentable projects.', zh: '把想法变成视觉方案、原型和可展示项目。' }),
    objective: l({ es: 'Convertir ideas en propuestas visuales, prototipos y proyectos presentables.', en: 'Turn ideas into visual proposals, prototypes and presentable projects.', zh: '把想法转化为视觉提案、原型和可展示项目。' }),
    resourceIds: ['canva-school', 'figma-basics', 'figma-beginners', 'notion-guides', 'github-skills'],
