];

const profileData = Object.fromEntries(
  profileDefinitions.map((profile) => [
    profile.id,
    {
      title: profile.title,
      objective: profile.objective,
      resources: profile.resourceIds.map((id) => {
        const resource = byId[id];
        return { name: resource.name, summary: resource.summary, url: resource.url };
      }),
    },
  ])
);

const glossary = [
  { term: 'Badge', body: l({ es: 'Insignia digital que muestra que completaste una actividad, curso o reto.', en: 'A digital badge showing that you completed an activity, course or challenge.', zh: '表示你完成了活动、课程或挑战的数字徽章。' }) },
  { term: 'MVP', body: l({ es: 'Version minima de una idea que permite probar si funciona y aprender rapido.', en: 'The smallest useful version of an idea that lets you test and learn quickly.', zh: '一个想法的最小可用版本，用来快速测试和学习。' }) },
  { term: 'GitHub', body: l({ es: 'Plataforma para guardar codigo, colaborar y mostrar proyectos tecnicos.', en: 'A platform to store code, collaborate and show technical projects.', zh: '用于保存代码、协作和展示技术项目的平台。' }) },
  { term: 'IoT', body: l({ es: 'Internet de las Cosas: dispositivos fisicos conectados que envian o reciben datos.', en: 'Internet of Things: connected physical devices that send or receive data.', zh: '物联网：可以发送或接收数据的联网物理设备。' }) },
  { term: 'Mainframe', body: l({ es: 'Computadora empresarial de alta capacidad usada por bancos, aerolineas, gobiernos y grandes organizaciones.', en: 'A high-capacity enterprise computer used by banks, airlines, governments and large organizations.', zh: '银行、航空、政府和大型组织使用的高容量企业计算机。' }) },
  { term: 'TinyML', body: l({ es: 'Machine learning ejecutado en dispositivos pequenos como microcontroladores y sensores.', en: 'Machine learning running on small devices such as microcontrollers and sensors.', zh: '运行在微控制器和传感器等小型设备上的机器学习。' }) },
  { term: l({ es: 'Portafolio', en: 'Portfolio', zh: '作品集' }), body: l({ es: 'Coleccion de proyectos que demuestra lo que sabes construir.', en: 'A collection of projects that proves what you can build.', zh: '展示你能构建什么的项目集合。' }) },
];

const recommendationJson = JSON.stringify(profileData).replace(/</g, '\\u003c');
---

<Layout lang={lang} title={t('meta.title')} description={t('meta.description')}>
  <main class="next-page min-h-screen bg-[#050506] text-white overflow-hidden">
    <section class="relative px-5 sm:px-6 pt-32 pb-20 sm:pt-40 sm:pb-28">
      <div class="max-w-[1120px] mx-auto">
        <p class="text-sm font-black uppercase tracking-[0.18em] text-white/38 mb-5">{t('hero.title')}</p>
        <h1 class="text-[clamp(3.2rem,10vw,7.5rem)] font-black leading-[0.92] tracking-normal max-w-[960px] mb-7">{t('hero.headline')}</h1>
        <p class="text-[1.08rem] md:text-[1.35rem] leading-relaxed text-white/64 font-medium max-w-[720px] mb-9">{t('hero.body')}</p>
        <a href="#profiles" class="inline-flex items-center justify-center px-8 py-3.5 bg-white text-black rounded-full text-[1rem] font-bold hover:bg-white/88 transition-colors w-full sm:w-auto">
          {t('hero.cta')} <span aria-hidden="true" class="ml-2">↓</span>
        </a>
      </div>
    </section>

    <section class="max-w-[1120px] mx-auto px-5 sm:px-6 pb-16">
      <div class="grid grid-cols-1 lg:grid-cols-[0.78fr_1.22fr] gap-6 items-center border border-white/10 bg-white p-6 md:p-8 text-black">
        <div class="h-24 w-24 bg-[#050506] text-white flex items-center justify-center text-xl font-black tracking-normal">LAB</div>
        <div>
          <p class="text-xs font-black uppercase tracking-[0.16em] text-black/38 mb-3">{laptopLab.eyebrow}</p>
          <h2 class="text-3xl md:text-5xl font-black tracking-normal mb-4">{laptopLab.title}</h2>
          <p class="text-[1.05rem] md:text-[1.2rem] text-black/62 font-semibold leading-relaxed max-w-[760px] mb-7">{laptopLab.body}</p>
          <a href={`/${lang}/next/laptop-lab`} class="inline-flex items-center justify-center px-7 py-3 bg-[#050506] text-white text-sm font-black hover:bg-black/88 transition-colors w-full sm:w-auto">
            {laptopLab.cta} <span aria-hidden="true" class="ml-2">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <section id="profiles" class="max-w-[1120px] mx-auto px-5 sm:px-6 py-18 sm:py-24 border-t border-white/10 scroll-mt-24">
      <div class="mb-10 max-w-[760px]">
        <h2 class="text-3xl md:text-5xl font-black tracking-normal mb-4">{t('selector.title')}</h2>
        <p class="text-white/64 font-medium leading-relaxed text-[1.05rem] md:text-[1.2rem]">{t('selector.body')}</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {profileDefinitions.map((profile, index) => (
          <button type="button" data-profile={profile.id} class={`profile-card text-left rounded-[1.5rem] border p-5 min-h-[220px] transition-all ${index === 0 ? 'is-active border-white bg-white text-black' : 'border-white/10 bg-white/[0.04] text-white hover:bg-white/[0.08]'}`}>
            <span class="profile-card__icon h-11 w-11 rounded-xl flex items-center justify-center text-sm font-black mb-5">{profile.icon}</span>
            <h3 class="text-xl font-black leading-tight mb-3">{profile.title}</h3>
            <p class="profile-card__description text-sm font-semibold leading-relaxed mb-5">{profile.description}</p>
            <span class="profile-card__action text-sm font-black">{t('selector.button')}</span>
          </button>
        ))}
      </div>
    </section>

    <section class="max-w-[1120px] mx-auto px-5 sm:px-6 py-10 sm:py-14">
      <div class="rounded-[1.75rem] border border-white/10 bg-white text-black p-6 md:p-9">
        <p class="text-xs font-black uppercase tracking-[0.16em] text-black/38 mb-3">{t('recommended.label')}</p>
        <div class="grid grid-cols-1 lg:grid-cols-[0.75fr_1.25fr] gap-8">
          <div>
            <h2 id="recommendation-title" class="text-3xl md:text-5xl font-black tracking-normal leading-tight mb-5">{profileData.start.title}</h2>
            <p class="text-sm font-black uppercase tracking-[0.14em] text-black/36 mb-2">{t('recommended.objective')}</p>
            <p id="recommendation-objective" class="text-[1.05rem] font-semibold leading-relaxed text-black/64">{profileData.start.objective}</p>
          </div>
          <div>
            <h3 class="text-xl font-black mb-5">{t('recommended.resources')}</h3>
            <div id="recommendation-list" class="grid grid-cols-1 gap-3">
              {profileData.start.resources.map((resource, index) => (
                <a href={resource.url} target="_blank" rel="noopener noreferrer" class="group rounded-2xl border border-black/8 bg-black/[0.03] p-4 hover:bg-black/[0.06] transition-colors">
                  <p class="text-xs font-black text-black/36 mb-2">{String(index + 1).padStart(2, '0')}</p>
                  <h4 class="font-black leading-tight mb-1">{resource.name}</h4>
                  <p class="text-sm font-semibold text-black/58 leading-relaxed">{resource.summary}</p>
                </a>
              ))}
            </div>
            <a href="#catalog" class="mt-6 inline-flex items-center justify-center px-6 py-3 bg-[#050506] text-white rounded-full text-sm font-black hover:bg-black/88 transition-colors w-full sm:w-auto">
              {t('recommended.catalog')} <span aria-hidden="true" class="ml-2">↓</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="catalog" class="max-w-[1120px] mx-auto px-5 sm:px-6 py-18 sm:py-24 scroll-mt-24">
      <div class="mb-10 max-w-[820px]">
        <h2 class="text-3xl md:text-5xl font-black tracking-normal mb-4">{t('catalog.title')}</h2>
        <p class="text-white/64 font-medium leading-relaxed text-[1.05rem] md:text-[1.2rem]">{t('catalog.body')}</p>
      </div>
      <div class="space-y-5">
        {tracks.map((track) => (
          <details class="group rounded-[1.5rem] border border-white/10 bg-white/[0.04] overflow-hidden" open={track.id === 'software' || track.id === 'hardware'}>
            <summary class="cursor-pointer list-none p-6 md:p-7 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
              <div>
                <h3 class="text-2xl md:text-3xl font-black">{track.title}</h3>
                <p class="text-white/56 font-semibold leading-relaxed mt-2 max-w-[760px]">{track.body}</p>
                {track.bridge && <p class="text-white font-black leading-snug mt-4 max-w-[680px]">{track.bridge}</p>}
              </div>
              <span class="h-10 w-10 rounded-full bg-white text-black flex items-center justify-center font-black flex-shrink-0 group-open:rotate-45 transition-transform">+</span>
            </summary>
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 px-4 md:px-6 pb-6">
              {resources.filter((resource) => resource.track === track.id).map((resource) => (
                <article class="rounded-[1.25rem] bg-white text-black p-5 flex flex-col min-h-[360px]">
                  <div class="h-10 w-fit min-w-10 px-3 rounded-xl bg-[#050506] text-white flex items-center justify-center text-xs font-black mb-5">{resource.logo}</div>
                  <h4 class="text-xl font-black leading-tight mb-2">{resource.name}</h4>
                  <p class="text-sm font-black text-black/42 mb-5">{resource.tags}</p>
                  <div class="grid grid-cols-1 gap-2 text-sm font-semibold text-black/60 mb-5">
                    <p><span class="font-black text-black">{t('catalog.level')}:</span> {resource.level}</p>
                    <p><span class="font-black text-black">{t('catalog.cost')}:</span> {resource.cost}</p>
                    <p><span class="font-black text-black">{t('catalog.credentials')}:</span> {resource.credentials ?? ui.no}</p>
                  </div>
                  <p class="text-sm font-semibold leading-relaxed text-black/62 mb-5">{resource.summary}</p>
                  <div class="mt-auto flex flex-col gap-3">
                    <a href={resource.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-5 py-2.5 bg-[#050506] text-white rounded-full text-sm font-black hover:bg-black/88 transition-colors">
                      {t('catalog.visit')}
                    </a>
                    <details class="rounded-2xl border border-black/8 bg-black/[0.03]">
                      <summary class="cursor-pointer list-none px-4 py-3 text-sm font-black">{t('catalog.details')}</summary>
                      <div class="px-4 pb-4 text-sm font-semibold text-black/62 leading-relaxed space-y-4">
                        <div>
                          <p class="font-black text-black mb-2">{t('catalog.learn')}</p>
                          <ul class="space-y-1">
                            {resource.learn.map((item) => <li>• {item}</li>)}
                          </ul>
                        </div>
                        <p><span class="font-black text-black">{t('catalog.ideal')}:</span> {resource.ideal}</p>
                        {resource.firstStep && <p><span class="font-black text-black">{t('catalog.firstStep')}:</span> {resource.firstStep}</p>}
                        <a href={resource.url} target="_blank" rel="noopener noreferrer" class="font-black text-black underline underline-offset-4">{t('catalog.official')}</a>
                      </div>
                    </details>
                  </div>
                </article>
              ))}
            </div>
          </details>
        ))}
      </div>
      <p class="text-xs md:text-sm text-white/42 font-semibold leading-relaxed mt-6 max-w-[880px]">{t('note.body')}</p>
    </section>

    <section class="max-w-[1120px] mx-auto px-5 sm:px-6 py-18 sm:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-[0.75fr_1.25fr] gap-10">
        <div>
          <h2 class="text-3xl md:text-5xl font-black tracking-normal mb-4">{t('glossary.title')}</h2>
          <p class="text-white/64 font-medium leading-relaxed">{t('glossary.body')}</p>
        </div>
        <div class="space-y-3">
          {glossary.map((item) => (
            <details class="rounded-2xl border border-white/10 bg-white/[0.04] p-5">
              <summary class="cursor-pointer list-none font-black text-lg">{item.term}</summary>
              <p class="text-white/62 font-medium leading-relaxed mt-3">{item.body}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="max-w-[1120px] mx-auto px-5 sm:px-6 py-18 sm:py-24">
      <div class="rounded-[1.75rem] border border-white/10 bg-white/[0.04] p-7 md:p-9">
        <h2 class="text-2xl md:text-3xl font-black tracking-normal mb-4">{t('note.title')}</h2>
        <p class="text-white/62 font-medium leading-relaxed max-w-[940px]">{t('note.body')}</p>
      </div>
    </section>

    <section class="max-w-[920px] mx-auto px-5 sm:px-6 pt-10 pb-24 sm:pb-32 text-center">
      <p class="text-2xl md:text-4xl font-black leading-tight mb-5">{t('finalCta.line1')}</p>
      <p class="text-[1.05rem] md:text-[1.35rem] text-white/64 font-semibold leading-relaxed mb-7">{t('finalCta.line2')}</p>
      <p class="text-3xl md:text-5xl font-black mb-9">{t('finalCta.brand')}</p>
      <a href={`/${lang}/next`} class="inline-flex items-center justify-center px-9 py-4 bg-white text-black rounded-full text-[1rem] font-bold hover:bg-white/88 transition-colors w-full sm:w-auto">
        {t('finalCta.button')}
      </a>
    </section>
  </main>

  <script type="application/json" id="next-profile-data" set:html={recommendationJson}></script>
  <script>
    const dataScript = document.getElementById('next-profile-data');
    const profileData = dataScript?.textContent ? JSON.parse(dataScript.textContent) : {};
    const buttons = Array.from(document.querySelectorAll('[data-profile]'));
    const title = document.getElementById('recommendation-title');
    const objective = document.getElementById('recommendation-objective');
    const list = document.getElementById('recommendation-list');

    function renderProfile(profileId: string) {
      const profile = profileData[profileId] || profileData.start;
      if (!profile || !title || !objective || !list) return;

      title.textContent = profile.title;
      objective.textContent = profile.objective;
      list.innerHTML = profile.resources.map((resource: { url: string; name: string; summary: string }, index: number) => `
        <a href="${resource.url}" target="_blank" rel="noopener noreferrer" class="group rounded-2xl border border-black/8 bg-black/[0.03] p-4 hover:bg-black/[0.06] transition-colors">
          <p class="text-xs font-black text-black/36 mb-2">${String(index + 1).padStart(2, '0')}</p>
          <h4 class="font-black leading-tight mb-1">${resource.name}</h4>
          <p class="text-sm font-semibold text-black/58 leading-relaxed">${resource.summary}</p>
        </a>
      `).join('');

      buttons.forEach((button) => {
        const isActive = button.getAttribute('data-profile') === profileId;
        button.classList.toggle('is-active', isActive);
        button.classList.toggle('border-white', isActive);
        button.classList.toggle('bg-white', isActive);
        button.classList.toggle('text-black', isActive);
        button.classList.toggle('border-white/10', !isActive);
        button.classList.toggle('bg-white/[0.04]', !isActive);
        button.classList.toggle('text-white', !isActive);
      });
    }

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const profileId = button.getAttribute('data-profile') || 'start';
        renderProfile(profileId);
        document.getElementById('recommendation-title')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });
  </script>
  <style>
    .profile-card .profile-card__icon {
      background: #fff;
      color: #050506;
    }

    .profile-card .profile-card__description {
      color: rgba(255, 255, 255, 0.54);
    }

    .profile-card .profile-card__action {
      color: #fff;
    }

    .profile-card.is-active .profile-card__icon {
      background: #050506;
      color: #fff;
    }

    .profile-card.is-active .profile-card__description {
      color: rgba(0, 0, 0, 0.58);
    }

    .profile-card.is-active .profile-card__action {
      color: #050506;
    }
  </style>
</Layout>
