---
import Layout from '../../../layouts/Layout.astro';
import type { UiLanguage } from '../../../i18n/config';
import { languages } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/utils';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

type TrackId = 'software' | 'hardware' | 'creative' | 'cybersecurity';
type ProfileId = 'start' | 'programming' | 'mechatronics' | 'ai' | 'design';
type Localized = Record<UiLanguage, string>;
type Resource = {
  id: string;
  track: TrackId;
  logo: string;
  name: string;
  tags: string;
  level: string;
  cost: string;
  credentials?: string;
  summary: string;
  ideal: string;
  firstStep?: string;
  learn: string[];
  url: string;
};

const { lang } = Astro.params as { lang: UiLanguage };
const t = useTranslations(lang, 'nextResources');
const l = (value: Localized) => value[lang] ?? value.es;

