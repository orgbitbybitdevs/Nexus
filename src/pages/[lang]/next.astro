---
import Layout from '../../layouts/Layout.astro';
import type { UiLanguage } from '../../i18n/config';
import { languages } from '../../i18n/config';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: UiLanguage };
const t = useTranslations(lang, 'next');
const flowItems = t('flow.items').split('|');
const day1Items = t('lists.day1').split('|');
const day2Items = t('lists.day2').split('|');
const includeItems = t('lists.includes').split('|');
const continuityItems = t('continuity.items').split('|');
const routeFamilies = [
  { key: 'softwareAi', items: t('routes.softwareAi.items').split('|') },
  { key: 'hardwareSmartSystems', items: t('routes.hardwareSmartSystems.items').split('|') },
];
const laptopLab = {
  es: {
    eyebrow: 'Herramienta NEXT',
    title: 'NEXT Laptop Lab',
    body: 'Descubre qué computadora necesitas realmente según tu carrera, tus proyectos y la vida que quieres construir.',
    cta: 'Analizar mi equipo ideal',
  },
  en: {
    eyebrow: 'NEXT tool',
    title: 'NEXT Laptop Lab',
    body: 'Discover what computer you really need according to your career, projects and the life you want to build.',
    cta: 'Analyze my ideal setup',
  },
  zh: {
    eyebrow: 'NEXT 工具',
    title: 'NEXT Laptop Lab',
    body: '根据你的专业、项目和想要构建的生活，了解真正需要的电脑配置。',
    cta: '分析我的理想设备',
  },
}[lang];
---

<Layout lang={lang} title={t('meta.title')} description={t('meta.description')}>
  <main class="next-page min-h-screen bg-[#050506] text-white overflow-hidden">
    <section class="relative min-h-[100svh] flex items-center px-5 sm:px-6 pt-28 sm:pt-32 pb-16 sm:pb-20">
      <div class="max-w-[1220px] mx-auto grid grid-cols-1 lg:grid-cols-[0.95fr_1.05fr] gap-8 sm:gap-12 lg:gap-16 items-center w-full relative z-10">
        <div class="order-1">
          <img src="/next/next_letters.png" alt="NEXT" class="w-[min(68vw,300px)] h-auto object-contain mb-8 sm:mb-12 mix-blend-screen" loading="eager" decoding="async" />
          <h1 class="text-[clamp(3.5rem,15vw,8.5rem)] font-black leading-[0.9] tracking-normal mb-6 sm:mb-8">
            {t('hero.headline')}
          </h1>
          <div class="space-y-1 text-[clamp(1.05rem,5vw,1.8rem)] font-semibold text-white/72 mb-7 sm:mb-10">
            <p>{t('hero.line1')}</p>
            <p>{t('hero.line2')}</p>
            <p>{t('hero.line3')}</p>
          </div>
          <p class="text-[1rem] md:text-[1.35rem] text-white/64 font-medium leading-relaxed max-w-[520px] mb-8 sm:mb-10">
            {t('hero.subtitle')}
          </p>
          <div class="flex flex-col sm:flex-row sm:items-center gap-5">
            <button type="button" data-join-cta aria-disabled="true" class="inline-flex items-center justify-center px-8 py-3.5 bg-white text-black rounded-full text-[1rem] font-bold opacity-90 cursor-not-allowed shadow-[0_18px_45px_rgba(255,255,255,0.12)] w-full sm:w-auto">
              {t('hero.cta')}
            </button>
            <div>
              <p class="text-xs font-black uppercase tracking-[0.18em] text-white/36 mb-1">{t('hero.priceLabel')}</p>
              <p class="text-2xl font-black tracking-normal">{t('hero.price')}</p>
              <p class="text-sm font-semibold text-white/48">{t('hero.limited')}</p>
            </div>
          </div>
        </div>

        <div class="order-2 relative h-[240px] sm:h-[40svh] lg:h-auto lg:min-h-[620px] flex items-center justify-center">
          <div class="next-cube-wrap w-[min(76vw,560px)] max-h-full">
            <img src="/next/next_cube.png" alt="" class="next-cube-float w-full max-h-full h-auto object-contain" loading="eager" decoding="async" />
          </div>
        </div>
      </div>
    </section>

    <section class="max-w-[1120px] mx-auto px-5 sm:px-6 py-20 sm:py-28 border-t border-white/10">
      <div class="grid grid-cols-1 lg:grid-cols-[0.75fr_1.25fr] gap-12">
        <h2 class="text-[clamp(2.3rem,5vw,4.5rem)] font-black tracking-normal leading-[0.95]">{t('intro.title')}</h2>
        <div class="space-y-6 text-[1.05rem] md:text-[1.22rem] leading-relaxed text-white/66 font-medium">
          <p>{t('intro.p1')}</p>
          <p>{t('intro.p2')}</p>
          <p class="text-white text-[1.45rem] md:text-[1.85rem] font-black leading-tight py-4">{t('intro.quote')}</p>
          <p class="text-white/86">{t('intro.p6')}</p>
        </div>
      </div>
    </section>

    <section class="max-w-[1120px] mx-auto px-5 sm:px-6 py-18 sm:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.15fr] gap-10 lg:gap-14 items-start">
        <h2 class="text-[clamp(2.4rem,6vw,5rem)] font-black tracking-normal leading-[0.95]">{t('notOnlyAi.title')}</h2>
        <div>
          <p class="text-[1.05rem] md:text-[1.28rem] leading-relaxed text-white/66 font-medium mb-10">{t('notOnlyAi.body')}</p>
          <p class="text-[clamp(2rem,5vw,4.4rem)] font-black leading-[1.02] tracking-normal text-white">{t('notOnlyAi.quote')}</p>
        </div>
      </div>
    </section>

    <section class="max-w-[1120px] mx-auto px-5 sm:px-6 py-18 sm:py-24">
      <h2 class="text-4xl md:text-6xl font-black tracking-normal mb-12">{t('days.title')}</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {[
          { title: t('days.day1'), body: t('days.day1Body'), goal: t('days.day1Goal'), items: day1Items },
          { title: t('days.day2'), body: t('days.day2Body'), goal: t('days.day2Goal'), items: day2Items },
        ].map(({ title, body, goal, items }) => (
          <article class="rounded-[1.75rem] border border-white/10 bg-white/[0.04] p-7 md:p-9">
            <h3 class="text-2xl font-black mb-4">{title}</h3>
            <p class="text-white/64 font-medium leading-relaxed mb-7">{body}</p>
            <ul class="space-y-3 mb-7">
              {items.map((item) => (
                <li class="flex gap-3 text-sm font-semibold text-white/76">
                  <span class="mt-1 h-1.5 w-1.5 rounded-full bg-white/70 flex-shrink-0"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <p class="text-white/82 font-semibold leading-relaxed">{goal}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="max-w-[1120px] mx-auto px-5 sm:px-6 py-18 sm:py-24">
      <div class="rounded-[2rem] border border-white/10 bg-white text-black p-8 md:p-12">
        <h2 class="text-3xl md:text-5xl font-black tracking-normal mb-10">{t('flow.title')}</h2>
        <div class="flex flex-wrap gap-3 mb-10">
          {flowItems.map((item) => (
            <span class="px-4 py-2 rounded-full bg-[#050506] text-white text-sm font-bold">{item}</span>
          ))}
        </div>
        <p class="text-[1.1rem] md:text-[1.3rem] text-black/64 font-semibold leading-relaxed max-w-[760px]">{t('flow.body')}</p>
      </div>
    </section>

    <section class="max-w-[1120px] mx-auto px-5 sm:px-6 py-18 sm:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14">
        <div>
          <h2 class="text-3xl md:text-5xl font-black tracking-normal mb-8">{t('includes.title')}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {includeItems.map((item) => (
              <div class="rounded-2xl border border-white/10 bg-white/[0.04] px-4 py-4 text-sm font-bold text-white/76">{item}</div>
            ))}
          </div>
        </div>
        <div class="lg:pt-16 rounded-[1.75rem] border border-white/10 bg-white/[0.04] p-7 md:p-9 self-start">
          <h2 class="text-3xl font-black tracking-normal mb-5">{t('after.title')}</h2>
          <p class="text-white text-[1.2rem] font-black leading-snug mb-5">{t('after.subtitle')}</p>
          <p class="text-white/66 font-medium leading-relaxed text-[1.08rem] mb-7">{t('after.body')}</p>
          <p class="text-white font-black text-[1.55rem] leading-tight">{t('after.quote')}</p>
        </div>
      </div>
    </section>

    <section class="max-w-[1120px] mx-auto px-5 sm:px-6 py-10 sm:py-14">
      <div class="grid grid-cols-1 lg:grid-cols-[0.72fr_1.28fr] gap-6 items-stretch border border-white/10 bg-white/[0.04] p-6 md:p-8">
        <div class="flex items-center">
          <div class="h-24 w-24 rounded-2xl border border-white/10 bg-white/[0.06] flex items-center justify-center overflow-hidden">
            <img src="/next/lab.png" alt="NEXT Laptop Lab" class="h-full w-full object-contain scale-125" loading="lazy" decoding="async" />
          </div>
        </div>
        <div>
          <p class="text-xs font-black uppercase tracking-[0.16em] text-white/36 mb-3">{laptopLab.eyebrow}</p>
          <h2 class="text-3xl md:text-5xl font-black tracking-normal mb-4">{laptopLab.title}</h2>
          <p class="text-[1.05rem] md:text-[1.2rem] text-white/64 font-medium leading-relaxed max-w-[740px] mb-7">{laptopLab.body}</p>
          <a href={`/${lang}/next/laptop-lab`} class="inline-flex items-center justify-center px-7 py-3 bg-white text-black text-sm font-black hover:bg-white/88 transition-colors w-full sm:w-auto">
            {laptopLab.cta} <span aria-hidden="true" class="ml-2">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <section class="max-w-[1120px] mx-auto px-5 sm:px-6 py-18 sm:py-24">
      <div class="mb-10 max-w-[900px]">
        <h2 class="text-3xl md:text-5xl font-black tracking-normal mb-4">{t('routes.title')}</h2>
        <p class="text-xl md:text-2xl font-black text-white/86 mb-5">{t('routes.subtitle')}</p>
        <p class="text-[1.05rem] md:text-[1.2rem] text-white/64 font-medium leading-relaxed">{t('routes.body')}</p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
        {routeFamilies.map(({ key, items }) => (
          <article class="rounded-[1.5rem] border border-white/10 bg-white text-black p-6 md:p-7 min-h-[320px] flex flex-col">
            <div class="flex items-start justify-between gap-4 mb-7">
              <div>
                <p class="text-xs font-black uppercase tracking-[0.16em] text-black/38 mb-2">{t(`routes.${key}.eyebrow`)}</p>
                <h3 class="text-2xl md:text-3xl font-black leading-tight">{t(`routes.${key}.title`)}</h3>
              </div>
              <div class="h-12 w-12 rounded-xl bg-[#050506] text-white flex items-center justify-center text-sm font-black tracking-normal flex-shrink-0">
                {t(`routes.${key}.mark`)}
              </div>
            </div>
            <ul class="space-y-3 mt-auto">
              {items.map((item) => (
                <li class="flex gap-3 text-[0.95rem] font-bold text-black/68">
                  <span class="mt-2 h-1.5 w-1.5 rounded-full bg-black flex-shrink-0"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <p class="text-2xl md:text-4xl text-white font-black leading-tight mt-10 max-w-[760px]">{t('routes.bridge')}</p>
      <p class="text-xs md:text-sm text-white/42 font-semibold leading-relaxed mt-6 max-w-[880px]">{t('routes.disclaimer')}</p>
      <a href={`/${lang}/next/resources`} class="mt-8 inline-flex items-center justify-center px-8 py-3.5 bg-white text-black rounded-full text-[1rem] font-bold hover:bg-white/88 transition-colors w-full sm:w-auto">
        {t('routes.resourcesCta')} <span aria-hidden="true" class="ml-2">&rarr;</span>
      </a>
    </section>

    <section class="max-w-[1120px] mx-auto px-5 sm:px-6 py-18 sm:py-24">
      <div class="rounded-[2rem] border border-white/10 bg-white/[0.04] p-8 md:p-12">
        <h2 class="text-3xl md:text-5xl font-black tracking-normal mb-10">{t('continuity.title')}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-5 gap-3 mb-10">
          {continuityItems.map((item, index) => (
            <div class="relative rounded-2xl border border-white/10 bg-[#050506] px-4 py-5">
              <p class="text-xs font-black text-white/32 mb-2">{String(index + 1).padStart(2, '0')}</p>
              <p class="text-sm md:text-base font-black text-white">{item}</p>
              {index < continuityItems.length - 1 && (
                <span class="hidden sm:block absolute top-1/2 -right-2 text-white/28 font-black" aria-hidden="true">&rarr;</span>
              )}
            </div>
          ))}
        </div>
        <p class="text-[1.08rem] md:text-[1.28rem] text-white/66 font-medium leading-relaxed max-w-[820px]">{t('continuity.body')}</p>
      </div>
    </section>

    <section class="max-w-[1120px] mx-auto px-5 sm:px-6 py-18 sm:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-10 items-start border-t border-white/10 pt-16">
        <h2 class="text-3xl md:text-5xl font-black tracking-normal">{t('audience.title')}</h2>
        <div>
          <p class="text-[1.08rem] md:text-[1.28rem] text-white/66 font-medium leading-relaxed mb-6">{t('audience.body')}</p>
          <p class="text-white font-black text-[1.4rem] leading-snug">{t('audience.noExperience')}</p>
        </div>
      </div>
    </section>

    <section class="max-w-[1120px] mx-auto px-5 sm:px-6 py-20 sm:py-24 border-t border-white/10">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_0.8fr] gap-12 items-start">
        <div>
          <p class="text-sm font-black uppercase tracking-widest text-white/38 mb-6">{t('initiator.title')}</p>
          <h2 class="text-4xl md:text-6xl font-black tracking-normal mb-4">{t('initiator.name')}</h2>
          <p class="text-xl font-bold text-white/62 mb-8">{t('initiator.role')}</p>
          <p class="text-2xl font-black mb-1">{t('initiator.schoolZh')}</p>
          <p class="text-white/58 font-semibold mb-10">{t('initiator.school')}</p>
          <p class="text-[1.1rem] md:text-[1.25rem] text-white/66 font-medium leading-relaxed max-w-[720px]">{t('initiator.body')}</p>
        </div>
        <div class="rounded-[1.75rem] border border-white/10 bg-white/[0.04] p-8">
          <h3 class="text-2xl font-black mb-7">{t('info.title')}</h3>
          <div class="space-y-4">
            {[t('info.duration'), t('info.mode'), t('info.cost'), t('info.seats'), t('info.result')].map((item) => (
              <p class="border-b border-white/10 pb-4 text-white/76 font-bold">{item}</p>
            ))}
          </div>
          <button type="button" data-join-cta aria-disabled="true" class="mt-8 w-full inline-flex items-center justify-center px-8 py-3.5 bg-white text-black rounded-full text-[1rem] font-bold opacity-90 cursor-not-allowed">
            {t('hero.cta')}
          </button>
        </div>
      </div>
    </section>

    <section class="max-w-[920px] mx-auto px-5 sm:px-6 pt-10 pb-24 sm:pb-32 text-center">
      <h2 class="text-[clamp(2.5rem,8vw,5.8rem)] font-black tracking-normal leading-[0.95] mb-8">{t('finalCta.title')}</h2>
      <p class="text-2xl font-black mb-3">{t('finalCta.price')}</p>
      <p class="text-sm md:text-base font-semibold text-white/48 mb-9">{t('finalCta.meta')}</p>
      <button type="button" data-join-cta aria-disabled="true" class="inline-flex items-center justify-center px-9 py-4 bg-white text-black rounded-full text-[1rem] font-bold opacity-90 cursor-not-allowed w-full sm:w-auto">
        {t('hero.cta')}
      </button>
    </section>
  </main>
</Layout>
