---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Unirse — BitByBit Academy">
  <main class="min-h-screen flex items-center justify-center bg-apple-bg pt-24 pb-12">
    <div class="max-w-md w-full px-8">
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold tracking-tight text-apple-text mb-2">Únete a la academia</h1>
        <p class="text-apple-muted text-sm">Crea tu cuenta para comenzar a construir software real</p>
      </div>
      
      <div class="flex flex-col gap-3 mb-6">
        <button class="w-full flex items-center justify-center gap-3 py-3 border border-black/10 rounded-lg text-sm font-medium text-apple-text hover:bg-black/5 transition-colors">
          <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
          Continuar con GitHub
        </button>
        <button class="w-full flex items-center justify-center gap-3 py-3 border border-black/10 rounded-lg text-sm font-medium text-apple-text hover:bg-black/5 transition-colors">
          <svg viewBox="0 0 24 24" width="18" height="18" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          Continuar con Google
        </button>
      </div>

      <div class="flex items-center gap-4 mb-6">
        <hr class="flex-1 border-black/10">
        <span class="text-xs text-apple-muted font-medium">O usa tu correo electrónico</span>
        <hr class="flex-1 border-black/10">
      </div>

      <form class="space-y-4">
        <div>
          <label for="name" class="block text-xs font-medium text-apple-text mb-1 ml-1">Nombre completo</label>
          <input type="text" id="name" class="w-full px-4 py-2.5 rounded-lg border border-black/10 bg-white focus:outline-none focus:ring-2 focus:ring-apple-blue/50 transition-all text-sm" placeholder="Juan Pérez" required>
        </div>
        
        <div>
          <label for="email" class="block text-xs font-medium text-apple-text mb-1 ml-1">Correo electrónico</label>
          <input type="email" id="email" class="w-full px-4 py-2.5 rounded-lg border border-black/10 bg-white focus:outline-none focus:ring-2 focus:ring-apple-blue/50 transition-all text-sm" placeholder="tu@correo.com" required>
        </div>

        <div>
           <label for="password" class="block text-xs font-medium text-apple-text mb-1 ml-1">Contraseña</label>
           <input type="password" id="password" class="w-full px-4 py-2.5 rounded-lg border border-black/10 bg-white focus:outline-none focus:ring-2 focus:ring-apple-blue/50 transition-all text-sm" placeholder="••••••••" required>
        </div>
        
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="age" class="block text-xs font-medium text-apple-text mb-1 ml-1">Edad</label>
            <input type="number" id="age" min="10" max="100" class="w-full px-4 py-2.5 rounded-lg border border-black/10 bg-white focus:outline-none focus:ring-2 focus:ring-apple-blue/50 transition-all text-sm" placeholder="18" required>
          </div>
          <div>
            <label for="sex" class="block text-xs font-medium text-apple-text mb-1 ml-1">Sexo</label>
            <select id="sex" class="w-full px-4 py-2.5 rounded-lg border border-black/10 bg-white focus:outline-none focus:ring-2 focus:ring-apple-blue/50 transition-all appearance-none text-sm" required>
              <option value="" disabled selected>Selecciona</option>
              <option value="f">Femenino</option>
              <option value="m">Masculino</option>
              <option value="o">Otro</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
             <label for="country" class="block text-xs font-medium text-apple-text mb-1 ml-1">País</label>
             <input type="text" id="country" class="w-full px-4 py-2.5 rounded-lg border border-black/10 bg-white focus:outline-none focus:ring-2 focus:ring-apple-blue/50 transition-all text-sm" placeholder="México" required>
          </div>
          <div>
             <label for="github" class="block text-xs font-medium text-apple-text mb-1 ml-1">Usuario de GitHub</label>
             <input type="text" id="github" class="w-full px-4 py-2.5 rounded-lg border border-black/10 bg-white focus:outline-none focus:ring-2 focus:ring-apple-blue/50 transition-all text-sm" placeholder="@usuario" required>
          </div>
        </div>
        
        <button type="submit" class="w-full py-3.5 bg-apple-blue text-white rounded-lg font-medium text-sm hover:bg-apple-blue-hover transition-colors shadow-sm mt-6">
          Registrarse
        </button>
      </form>
      
      <p class="mt-6 text-center text-sm text-apple-muted">
        ¿Ya tienes cuenta? <a href="/login" class="text-apple-blue hover:underline">Inicia sesión</a>
      </p>
    </div>
  </main>
</Layout>
