---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Plataforma — BitByBit Academy">
  <main class="bg-white min-h-screen pt-32 pb-24 text-[#1D1D1F] overflow-x-hidden">
    
    <!-- 1) Hero -->
    <section class="max-w-[1280px] mx-auto px-6 md:px-12 mb-32">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <!-- Izquierda -->
        <div class="max-w-[600px]">
          <h1 class="text-[clamp(3rem,5vw,4rem)] font-bold tracking-tight leading-[1.05] mb-6">
            Un entorno real de ingeniería.
          </h1>
          <p class="text-[1.15rem] md:text-[1.25rem] text-[#6E6E73] font-medium leading-relaxed mb-10">
            Aprende construyendo sistemas reales con repositorios, colaboración y decisiones técnicas, no ejercicios aislados de principiante.
          </p>
          <button type="button" data-join-cta aria-disabled="true" class="inline-flex items-center justify-center px-8 py-3.5 bg-[#0071E3] text-white font-semibold rounded-full opacity-50 cursor-not-allowed shadow-sm">
            Unirme a la academia
          </button>
        </div>
        <!-- Derecha: Mock GitHub Preview (Mini card) -->
        <div class="relative w-full aspect-[4/3] bg-[#F5F5F7] rounded-3xl border border-black/5 shadow-[0_20px_40px_rgba(0,0,0,0.06)] overflow-hidden flex flex-col transform lg:-rotate-2 hover:rotate-0 transition-transform duration-500">
          <div class="flex items-center px-4 py-3 border-b border-black/5 bg-white">
            <div class="flex gap-2">
              <div class="w-3 h-3 rounded-full bg-black/10"></div>
              <div class="w-3 h-3 rounded-full bg-black/10"></div>
              <div class="w-3 h-3 rounded-full bg-black/10"></div>
            </div>
          </div>
          <div class="p-6 flex-1 flex flex-col font-mono text-xs text-[#6E6E73]">
            <div class="flex items-center gap-2 mb-4">
              <span class="font-bold text-[#1D1D1F]">orgbitbybitdevs</span> / <span class="font-bold text-[#0071E3]">nexus-core</span>
            </div>
            <p class="mb-4">Fix distributed cache timing issues in edge worker.</p>
            <div class="mt-auto flex gap-4 text-[0.7rem] font-bold">
              <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-yellow-400"></span> JavaScript</span>
              <span>Updated 5 mins ago</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2) Cómo funciona -->
    <section class="max-w-[1280px] mx-auto px-6 md:px-12 mb-32">
      <div class="flex flex-col md:flex-row gap-8 justify-between relative relative border-t border-black/5 pt-16">
        <!-- Paso 1 -->
        <div class="flex-1 group hover:-translate-y-1 transition-transform duration-300">
          <p class="text-[0.8rem] font-bold text-[#6E6E73] mb-2 uppercase tracking-wider">01</p>
          <h3 class="text-[1.125rem] font-bold text-[#1D1D1F] mb-1">Te unes</h3>
          <p class="text-[0.85rem] font-medium text-[#6E6E73] leading-relaxed">Accedes a la academia y la comunidad oficial.</p>
        </div>
        <!-- Paso 2 -->
        <div class="flex-1 group hover:-translate-y-1 transition-transform duration-300">
          <p class="text-[0.8rem] font-bold text-[#6E6E73] mb-2 uppercase tracking-wider">02</p>
          <h3 class="text-[1.125rem] font-bold text-[#1D1D1F] mb-1">Acceso real</h3>
          <p class="text-[0.85rem] font-medium text-[#6E6E73] leading-relaxed">Ingresas a la organización oficial en GitHub.</p>
        </div>
        <!-- Paso 3 -->
        <div class="flex-1 group hover:-translate-y-1 transition-transform duration-300">
          <p class="text-[0.8rem] font-bold text-[#6E6E73] mb-2 uppercase tracking-wider">03</p>
          <h3 class="text-[1.125rem] font-bold text-[#1D1D1F] mb-1">Construyes</h3>
          <p class="text-[0.85rem] font-medium text-[#6E6E73] leading-relaxed">Trabajas en repositorios y sistemas de producción.</p>
        </div>
        <!-- Paso 4 -->
        <div class="flex-1 group hover:-translate-y-1 transition-transform duration-300">
          <p class="text-[0.8rem] font-bold text-[#6E6E73] mb-2 uppercase tracking-wider">04</p>
          <h3 class="text-[1.125rem] font-bold text-[#1D1D1F] mb-1">Colaboras</h3>
          <p class="text-[0.85rem] font-medium text-[#6E6E73] leading-relaxed">Recibes feedback y participas en revisiones de código.</p>
        </div>
      </div>
    </section>

    <!-- 3) Preview del Sistema (Core Visual) -->
    <section class="max-w-[900px] mx-auto px-6 mb-32 relative z-20">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold tracking-tight text-[#1D1D1F]">Simula el entorno de la industria.</h2>
      </div>

      <div class="bg-[#F5F5F7] rounded-2xl shadow-[0_10px_30px_rgba(0,0,0,0.08)] overflow-hidden font-mono text-sm border border-black/5">
        <!-- Header & Tabs -->
        <div class="border-b border-black/5 bg-white">
          <div class="px-6 py-4 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <svg viewBox="0 0 24 24" width="16" height="16" class="text-[#6E6E73]" stroke="currentColor" stroke-width="2" fill="none"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
              <span class="font-bold text-[#1D1D1F] tracking-tight">orgbitbybitdevs <span class="font-normal text-[#6E6E73] mx-1">/</span> <span class="text-[#0071E3]">heliosync-system</span></span>
              <span class="px-2 py-0.5 rounded-full border border-black/10 text-[0.65rem] font-bold text-[#6E6E73] ml-2">Public</span>
            </div>
            <button class="hidden sm:flex items-center gap-1.5 px-3 py-1 bg-black/5 hover:bg-black/10 transition-colors rounded-md text-xs font-semibold text-[#1D1D1F] border border-black/5 cursor-default">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" class="text-[#6E6E73]" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              Star
            </button>
          </div>
          <!-- Tabs -->
          <div class="flex px-6 gap-6 text-xs font-semibold text-[#6E6E73] mt-2 overflow-x-auto no-scrollbar">
            <button class="pb-3 border-b-2 border-[#0071E3] text-[#1D1D1F] flex items-center gap-2 whitespace-nowrap fake-tab cursor-default">Code</button>
            <button class="pb-3 border-b-2 border-transparent hover:text-[#1D1D1F] transition-colors flex items-center gap-2 whitespace-nowrap fake-tab cursor-default">Issues</button>
            <button class="pb-3 border-b-2 border-transparent hover:text-[#1D1D1F] transition-colors flex items-center gap-2 whitespace-nowrap fake-tab cursor-default">Pull Requests</button>
            <button class="pb-3 border-b-2 border-transparent hover:text-[#1D1D1F] transition-colors flex items-center gap-2 whitespace-nowrap fake-tab cursor-default">Actions</button>
          </div>
        </div>
        
        <!-- Viewer -->
        <div class="flex flex-col sm:flex-row pb-6">
          <!-- Left: File tree -->
          <div class="w-full sm:w-[30%] border-r border-black/5 p-4 space-y-1" id="file-tree">
            <!-- Interactivo -->
            <button class="w-full text-left px-3 py-1.5 rounded-md hover:bg-[#EAEAEA] transition-colors text-[#1D1D1F] flex items-center gap-2 mock-file cursor-pointer" data-target="folder">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" class="text-[#0071E3]"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>
              src
            </button>
            <button class="w-full text-left px-3 py-1.5 rounded-md hover:bg-[#EAEAEA] transition-colors text-[#1D1D1F] flex items-center gap-2 mock-file cursor-pointer" data-target="folder">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" class="text-[#0071E3]"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>
              hardware
            </button>
            <button class="w-full text-left px-3 py-1.5 rounded-md hover:bg-[#EAEAEA] transition-colors text-[#1D1D1F] flex items-center gap-2 mock-file cursor-pointer" data-target="folder">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" class="text-[#0071E3]"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>
              docs
            </button>
            <button class="w-full text-left px-3 py-1.5 rounded-md hover:bg-[#EAEAEA] transition-colors text-[#1D1D1F] flex items-center gap-2 bg-[#EAEAEA] mock-file cursor-pointer" data-target="readme" id="default-mock">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="text-[#6E6E73]"><path d="M14 2H6a2 2 0 0 0-2 2v16c0 1.1.9 2 2 2h12a2 2 0 0 0 2-2V8l-6-6z"/><path d="M14 3v5h5M16 13H8M16 17H8M10 9H8"/></svg>
              README.md
            </button>
            <button class="w-full text-left px-3 py-1.5 rounded-md hover:bg-[#EAEAEA] transition-colors text-[#1D1D1F] flex items-center gap-2 mock-file cursor-pointer" data-target="config">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="text-[#6E6E73]"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
              config.json
            </button>
          </div>
          <!-- Right: Code Viewer -->
          <div class="w-full sm:w-[70%] bg-white p-6 sm:p-8 overflow-x-auto text-[0.85rem] leading-loose text-black shadow-inner">
            <pre id="mock-code-content"><code><span class="text-[#6E6E73]"># HelioSync System</span>
Repositorio principal para integración IoT.

<span class="text-[#0071E3] font-bold">## Inicialización</span>

<span class="text-[#b15c00]">// system init</span>
<span class="font-bold">const</span> system = <span class="font-bold">new</span> <span class="text-[#0071E3]">IoTSystem</span>();

system.<span class="text-[#0071E3]">connect</span>();
system.<span class="text-[#0071E3]">publish</span>(<span class="text-[#0F7A59]">"temperature"</span>, <span class="text-[#0F7A59]">24.3</span>);</code></pre>
          </div>
        </div>
        <!-- Footer -->
        <div class="border-t border-black/5 px-6 py-3 bg-white flex items-center justify-between text-xs text-[#6E6E73] font-sans font-medium">
          <div class="flex items-center gap-1.5">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            3 contributors
          </div>
          <div>Last update: 2 hours ago</div>
        </div>
      </div>
    </section>

    <!-- 5) Qué hay dentro -->
    <section class="max-w-[1280px] mx-auto px-6 md:px-12 mb-32">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
        <div class="bg-white p-8 rounded-2xl border border-[#E5E5E7] hover:shadow-[0_10px_30px_rgba(0,0,0,0.04)] transition-shadow">
          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" class="text-[#1D1D1F] mb-6"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          <h3 class="text-xl font-bold text-[#1D1D1F] mb-2">Repositorios</h3>
          <p class="text-[0.95rem] text-[#6E6E73] font-medium leading-relaxed">Proyectos estructurados como en la industria</p>
        </div>
        <div class="bg-white p-8 rounded-2xl border border-[#E5E5E7] hover:shadow-[0_10px_30px_rgba(0,0,0,0.04)] transition-shadow">
          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" class="text-[#1D1D1F] mb-6"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
          <h3 class="text-xl font-bold text-[#1D1D1F] mb-2">Retos</h3>
          <p class="text-[0.95rem] text-[#6E6E73] font-medium leading-relaxed">Problemas que requieren diseño, no solo código</p>
        </div>
        <div class="bg-white p-8 rounded-2xl border border-[#E5E5E7] hover:shadow-[0_10px_30px_rgba(0,0,0,0.04)] transition-shadow">
          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" class="text-[#1D1D1F] mb-6"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
          <h3 class="text-xl font-bold text-[#1D1D1F] mb-2">Code reviews</h3>
          <p class="text-[0.95rem] text-[#6E6E73] font-medium leading-relaxed">Aprendes a leer, escribir y mejorar código</p>
        </div>
        <div class="bg-white p-8 rounded-2xl border border-[#E5E5E7] hover:shadow-[0_10px_30px_rgba(0,0,0,0.04)] transition-shadow">
          <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" class="text-[#1D1D1F] mb-6"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
          <h3 class="text-xl font-bold text-[#1D1D1F] mb-2">Sistemas</h3>
          <p class="text-[0.95rem] text-[#6E6E73] font-medium leading-relaxed">Integración de software y hardware</p>
        </div>
      </div>
    </section>

    <!-- 6) Colaboración -->
    <section class="max-w-[1280px] mx-auto px-6 md:px-12 mb-32">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <!-- Izquierda: Texto cortito -->
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-[#1D1D1F] mb-4">Colaboración real.</h2>
          <p class="text-[1.15rem] leading-relaxed text-[#6E6E73] font-medium">
            Toma control del ciclo de vida del código. Participando activamente, no solo desarrollando en aislamiento, aprendes las mejores prácticas operativas y de revisión dentro de arquitecturas asíncronas de la industria.
          </p>
        </div>
        <!-- Derecha: Mini Mock de Pull Request -->
        <div class="bg-[#F5F5F7] rounded-3xl p-6 lg:p-8 border border-[#E5E5E7] shadow-sm">
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-black/5 font-sans">
            <h3 class="font-bold text-[1.1rem] text-[#1D1D1F] mb-1">Add sensor data pipeline</h3>
            <p class="text-[0.85rem] text-[#6E6E73] mb-6 border-b border-black/5 pb-4">
              <span class="bg-green-100 text-green-700 px-2 py-0.5 rounded-full font-bold text-[0.7rem] mr-2">Open</span>
              <span class="font-bold">deepdevjose</span> wants to merge 3 commits into <code class="bg-black/5 px-1 rounded">main</code>
            </p>
            
            <div class="space-y-4 mb-6 relative">
              <div class="absolute left-3 top-2 bottom-2 w-px bg-black/5 z-0"></div>
              
              <div class="flex gap-3 relative z-10">
                <div class="w-6 h-6 rounded-full bg-black/10 flex-shrink-0 flex items-center justify-center border-2 border-white">
                  <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none" class="text-[#6E6E73]"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                </div>
                <div class="bg-[#F5F5F7] rounded-xl rounded-tl-sm p-3 w-full border border-black/5">
                  <p class="text-[0.8rem] text-[#1D1D1F] font-medium font-mono mb-1"><span class="font-bold">reviewer</span> commented</p>
                  <p class="text-[0.85rem] text-[#6E6E73]">Consider separating concerns here to keep the gateway completely stateless.</p>
                </div>
              </div>

              <div class="flex gap-3 relative z-10 pt-2">
                <div class="w-6 h-6 rounded-full bg-[#0071E3]/20 flex-shrink-0 flex items-center justify-center border-2 border-white">
                  <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none" class="text-[#0071E3]"><path d="M20 6L9 17l-5-5"></path></svg>
                </div>
                <div class="bg-white border border-[#E5E5E7] shadow-sm rounded-xl p-3 w-full">
                  <p class="text-[0.8rem] text-[#1D1D1F] font-medium font-mono mb-1"><span class="font-bold">tech-lead</span> reviewed</p>
                  <p class="text-[0.85rem] text-[#6E6E73]">Good structure, but can be optimized before shipping to production.</p>
                </div>
              </div>
            </div>

            <div class="flex gap-3 mt-4">
              <button class="bg-[#0071E3] text-white px-4 py-1.5 rounded-lg text-[0.85rem] font-bold shadow-sm cursor-default">Approve</button>
              <button class="bg-[#F5F5F7] text-[#6E6E73] border border-[#E5E5E7] px-4 py-1.5 rounded-lg text-[0.85rem] font-bold hover:bg-[#EAEAEA] transition-colors cursor-default">Request changes</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 7) Ejemplo real (HelioSync) -->
    <section class="max-w-[1280px] mx-auto px-6 md:px-12 mb-32">
      <div class="bg-[#F5F5F7] rounded-[2rem] p-8 md:p-12 lg:p-16 border border-black/5 text-center flex flex-col items-center overflow-hidden">
        <h2 class="text-2xl font-bold tracking-tight text-[#1D1D1F] mb-2">HelioSync IoT / VLM Engine</h2>
        <p class="text-[1.1rem] text-[#6E6E73] font-medium mb-12 max-w-[600px]">
          Arquitecturas de producción listas. Motores de inferencia descentralizados y nodos embebidos distribuidos con control centralizado real.
        </p>
        <div class="w-full max-w-[800px] h-[300px] md:h-[400px] bg-white rounded-2xl shadow-sm border border-black/5 relative flex items-center justify-center overflow-hidden">
          <div class="absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-[#F5F5F7] to-transparent z-10 pointer-events-none"></div>
          
          <!-- Esquema visual abstracto (Representación elegante) -->
          <svg width="400" height="300" viewBox="0 0 400 300" fill="none" class="opacity-80">
            <!-- Conexión central -->
            <path d="M200 150 L100 80 M200 150 L300 80 M200 150 L200 250" stroke="#0071E3" stroke-width="2" stroke-dasharray="8 4" class="opacity-50"/>
            <circle cx="200" cy="150" r="40" fill="#0071E3" fill-opacity="0.1" stroke="#0071E3" stroke-width="2"/>
            <circle cx="200" cy="150" r="16" fill="#0071E3"/>
            <!-- Nodos -->
            <rect x="70" y="50" width="60" height="60" rx="16" fill="white" stroke="#6E6E73" stroke-width="2"/>
            <rect x="270" y="50" width="60" height="60" rx="16" fill="white" stroke="#6E6E73" stroke-width="2"/>
            <rect x="170" y="220" width="60" height="60" rx="16" fill="white" stroke="#6E6E73" stroke-width="2"/>
            <path d="M90 80 L110 80 M100 70 L100 90" stroke="#1D1D1F" stroke-width="2" stroke-linecap="round"/>
            <circle cx="300" cy="80" r="10" stroke="#1D1D1F" stroke-width="2" fill="none"/>
            <path d="M190 250 L210 250 M195 245 L205 245" stroke="#1D1D1F" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </div>
      </div>
    </section>

    <!-- 8) CTA final -->
    <section class="max-w-[800px] mx-auto px-6 text-center pb-16">
      <h2 class="text-[clamp(1.8rem,3vw,2.5rem)] font-bold tracking-tight text-[#1D1D1F] mb-8">
        Empieza a construir en un entorno real.
      </h2>
      <button type="button" data-join-cta aria-disabled="true" class="inline-flex items-center justify-center px-10 py-4 bg-[#0071E3] text-white text-[1.1rem] font-bold rounded-full opacity-50 cursor-not-allowed shadow-lg">
        Unirme a la academia
      </button>
    </section>

  </main>

  <!-- Interactive Fake Repo JS -->
  <script>
    document.addEventListener('astro:page-load', () => {
      const mockFiles = document.querySelectorAll('.mock-file');
      const codeViewer = document.getElementById('mock-code-content');

      const fileData: Record<string, string> = {
        'folder': `<span class="text-[#6E6E73]">/* Este directorio contiene múltiples módulos. */</span>\n<span class="text-[#b15c00]">Explora</span> los archivos individuales para ver el código.`,
        'readme': `<span class="text-[#6E6E73]"># HelioSync System</span>\nRepositorio principal para integración IoT.\n\n<span class="text-[#0071E3] font-bold">## Inicialización</span>\n\n<span class="text-[#b15c00]">// system init</span>\n<span class="font-bold">const</span> system = <span class="font-bold">new</span> <span class="text-[#0071E3]">IoTSystem</span>();\n\nsystem.<span class="text-[#0071E3]">connect</span>();\nsystem.<span class="text-[#0071E3]">publish</span>(<span class="text-[#0F7A59]">"temperature"</span>, <span class="text-[#0F7A59]">24.3</span>);`,
        'config': `<span class="text-[#0071E3] font-bold">&#123;</span>\n  <span class="text-[#1D1D1F]">"version"</span>: <span class="text-[#0F7A59]">"2.0.1"</span>,\n  <span class="text-[#1D1D1F]">"mode"</span>: <span class="text-[#0F7A59]">"production"</span>,\n  <span class="text-[#1D1D1F]">"telemetry"</span>: <span class="text-[#0071E3] font-bold">true</span>\n<span class="text-[#0071E3] font-bold">&#125;</span>`
      };

      mockFiles.forEach(btn => {
        btn.addEventListener('click', () => {
          // Reset styles
          mockFiles.forEach(b => b.classList.remove('bg-[#EAEAEA]'));
          // Add active style
          btn.classList.add('bg-[#EAEAEA]');
          
          const target = btn.getAttribute('data-target');
          if (target && codeViewer && fileData[target]) {
            codeViewer.innerHTML = `<code>${fileData[target]}</code>`;
          }
        });
      });
    });
  </script>
</Layout>
