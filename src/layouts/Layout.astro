---
import '../styles/global.css';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { UiLanguage } from '../i18n/config';
import { languages } from '../i18n/config';

interface Props {
  title?: string;
  description?: string;
  lang?: UiLanguage;
}

const lang: UiLanguage = Astro.props.lang ?? getLangFromUrl(Astro.url);
const tc = useTranslations(lang, 'common');

const {
  title = 'BitByBit Academy',
  description = tc('footer.tagline'),
} = Astro.props;

const currentPath = Astro.url.pathname;
const isNextPage = currentPath === `/${lang}/next` || currentPath.startsWith(`/${lang}/next/`);

const navItems = [
  { path: `/${lang}`,           label: tc('nav.home')     },
  { path: `/${lang}/plataforma`, label: tc('nav.platform') },
  { path: `/${lang}/proyectos`,  label: tc('nav.projects') },
  { path: `/${lang}/next`,       label: tc('nav.next')     },
  { path: `/${lang}/certified-tech`, label: tc('nav.certifiedTech') },
  { path: `/${lang}/mentores`,   label: tc('nav.mentors')  },
];

// Alternate lang hrefs for <link rel="alternate"> — good for SEO
const alternateLinks = Object.keys(languages).map(code => ({
  code,
  path: currentPath.replace(`/${lang}`, `/${code}`)
}));
const defaultPath = `/es${currentPath.replace(`/${lang}`, '')}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/icon.png" />
    <meta name="description" content={description} />
    <!-- Hreflang for SEO -->
    {alternateLinks.map(({ code, path }) => (
      <link rel="alternate" hreflang={code} href={path} />
    ))}
    <link rel="alternate" hreflang="x-default" href={defaultPath} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <nav class={`fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-4 sm:px-6 lg:px-12 py-4 transition-all ${isNextPage ? 'bg-[#050506] border-b border-white/10' : 'bg-apple-nav backdrop-blur-md border-b border-black/5'}`}>
      <a class="flex items-center gap-2 sm:gap-2.5 no-underline min-w-0" href={`/${lang}`}>
        <img src="/icon.png" alt="BitByBit Academy" class="w-8 h-8 object-contain" loading="lazy" decoding="async" />
        <span class={`hidden sm:inline font-sans font-bold text-sm tracking-tight ${isNextPage ? 'text-white' : 'text-apple-text'}`}>BitByBit Academy</span>
        <span class={`h-5 w-px ${isNextPage ? 'bg-white/18' : 'bg-black/10'}`} aria-hidden="true"></span>
        <img src="/next/next_letters.png" alt="NEXT" class={`w-14 sm:w-16 h-6 object-contain ${isNextPage ? 'mix-blend-screen' : 'mix-blend-multiply'}`} loading="lazy" decoding="async" />
      </a>
      <div class={`hidden lg:flex relative p-1 rounded-full border ${isNextPage ? 'bg-white/[0.06] border-white/10' : 'bg-black/[0.03] border-black/[0.05]'}`} id="nav-container">
        <div id="nav-pill" class={`absolute top-1 bottom-1 left-0 rounded-full transition-all duration-300 ease-out z-0 opacity-0 pointer-events-none ${isNextPage ? 'bg-white/14' : 'bg-apple-blue/15 backdrop-blur-md'}`}></div>
        {navItems.map(item => {
          const isActive = currentPath === item.path || (item.path !== `/${lang}` && currentPath.startsWith(item.path));
          return (
            <a
              href={item.path}
              class={`nav-link relative z-10 px-3 xl:px-4 py-1.5 font-sans text-xs font-semibold transition-colors duration-300 no-underline rounded-full ${isActive ? (isNextPage ? 'text-white active-nav-item' : 'text-apple-blue active-nav-item') : (isNextPage ? 'text-white/48 hover:text-white' : 'text-apple-muted hover:text-apple-text')}`}
              data-active={isActive ? 'true' : 'false'}
            >
              {item.label}
            </a>
          );
        })}
      </div>
      <div class="flex items-center gap-3 sm:gap-5">
        <!-- Language switcher -->
        <div class="relative group">
          <button class={`flex items-center gap-1 font-sans text-xs font-semibold transition-colors uppercase tracking-wider ${isNextPage ? 'text-white/54 group-hover:text-white' : 'text-apple-muted group-hover:text-apple-text'}`}>
            {lang}
            <svg class="w-3 h-3 opacity-50 group-hover:opacity-100 transition-opacity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          
          <div class={`absolute right-0 top-full mt-2 w-32 rounded-xl shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform translate-y-1 group-hover:translate-y-0 z-50 overflow-hidden ${isNextPage ? 'bg-[#050506] border border-white/10 shadow-black/40' : 'bg-white border border-black/5 shadow-black/5'}`}>
            <div class="py-1">
              {Object.entries(languages).map(([code, name]) => {
                const isActive = code === lang;
                const targetPath = currentPath.replace(`/${lang}`, `/${code}`);
                return (
                  <a 
                    href={targetPath} 
                    class={`block px-4 py-2.5 text-xs font-medium transition-colors ${isActive ? (isNextPage ? 'bg-white/10 text-white' : 'bg-apple-blue/5 text-apple-blue') : (isNextPage ? 'text-white/54 hover:bg-white/10 hover:text-white' : 'text-apple-muted hover:bg-black/5 hover:text-apple-text')}`}
                  >
                    <div class="flex items-center justify-between">
                      <span>{name}</span>
                      <span class="uppercase opacity-50 text-[10px] font-bold">{code}</span>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        </div>
        <a href="https://github.com/orgbitbybitdevs" target="_blank" rel="noopener noreferrer" class={`hidden sm:inline-flex transition-colors ${isNextPage ? 'text-white/54 hover:text-white' : 'text-apple-muted hover:text-apple-text'}`} title={tc('footer.github')}>
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
        </a>
        <button type="button" data-join-cta aria-disabled="true" class={`hidden sm:inline-flex font-sans text-xs font-medium px-4 py-1.5 rounded-full opacity-50 cursor-not-allowed ${isNextPage ? 'bg-white text-black' : 'bg-apple-blue text-white'}`}>{tc('cta.joinAcademy')}</button>
      </div>
    </nav>
    <div id="join-work-toast" class="join-work-toast" role="status" aria-live="polite" hidden>
      <div class="join-worker" aria-hidden="true">
        <span class="join-worker__helmet"></span>
        <span class="join-worker__head"></span>
        <span class="join-worker__body"></span>
        <span class="join-worker__arm"></span>
        <span class="join-worker__shovel"></span>
      </div>
      <div>
        <p class="join-work-toast__message">{tc('cta.workInProgress')}</p>
        <p class="join-work-toast__signature">{tc('cta.devSignature')}</p>
      </div>
    </div>
    <slot />
    <script>
      function setupJoinCta() {
        const toast = document.getElementById('join-work-toast');
        const buttons = document.querySelectorAll('[data-join-cta]');
        let hideTimer: number | undefined;

        if (!toast || buttons.length === 0) return;

        function showToast() {
          if (!toast) return;
          window.clearTimeout(hideTimer);
          toast.hidden = false;
          toast.classList.remove('is-visible');
          void toast.offsetWidth;
          toast.classList.add('is-visible');
          hideTimer = window.setTimeout(() => {
            toast.classList.remove('is-visible');
            window.setTimeout(() => {
              if (!toast.classList.contains('is-visible')) toast.hidden = true;
            }, 220);
          }, 2800);
        }

        buttons.forEach(button => {
          if (!(button instanceof HTMLElement) || button.dataset.joinCtaReady) return;
          button.dataset.joinCtaReady = 'true';
          button.addEventListener('click', (event) => {
            event.preventDefault();
            showToast();
          });
        });
      }

      function setupNav() {
        const container = document.getElementById('nav-container');
        const pill = document.getElementById('nav-pill');
        const links = document.querySelectorAll('.nav-link');

        if (!container || !pill || links.length === 0) return;

        let activeLink = document.querySelector('.active-nav-item') as HTMLElement;

        function movePill(el: HTMLElement) {
          if (!pill) return;
          pill.style.opacity = '1';
          pill.style.width = `${el.offsetWidth}px`;
          pill.style.transform = `translateX(${el.offsetLeft}px)`;
        }

        if (activeLink) movePill(activeLink);

        links.forEach(link => {
          link.addEventListener('mouseenter', (e) => movePill(e.target as HTMLElement));
        });

        container.addEventListener('mouseleave', () => {
          if (activeLink) movePill(activeLink);
          else pill.style.opacity = '0';
        });
      }

      setupNav();
      setupJoinCta();
      document.addEventListener('astro:page-load', setupNav);
      document.addEventListener('astro:page-load', setupJoinCta);
    </script>
  </body>
</html>
