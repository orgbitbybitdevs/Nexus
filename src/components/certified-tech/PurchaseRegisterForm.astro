---
import type { UiLanguage } from '../../i18n/config';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: UiLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang, 'certifiedTech');
const fields: Array<{ name: string; label: string; type: 'text' | 'tel' | 'date'; required: boolean }> = [
  { name: 'fullName', label: t('register.fullName'), type: 'text', required: true },
  { name: 'whatsapp', label: t('register.whatsapp'), type: 'tel', required: true },
  { name: 'model', label: t('register.model'), type: 'text', required: true },
  { name: 'purchaseDate', label: t('register.purchaseDate'), type: 'date', required: true },
  { name: 'purchaseCode', label: t('register.purchaseCode'), type: 'text', required: true },
  { name: 'referredBy', label: t('register.referredBy'), type: 'text', required: false },
];
---

<section id="registro" class="bg-apple-bg px-5 py-24 text-apple-text sm:px-8 sm:py-32">
  <div class="mx-auto grid max-w-[1120px] grid-cols-1 gap-10 lg:grid-cols-[0.78fr_1.22fr] lg:gap-14">
    <div>
      <p class="mb-5 text-xs font-black uppercase tracking-[0.18em] text-[#6F8069]">Certified record</p>
      <h2 class="text-[clamp(2.2rem,5vw,4.5rem)] font-black leading-[0.98] tracking-normal text-[#050506]">{t('register.title')}</h2>
      <p class="mt-7 text-[1.1rem] font-medium leading-relaxed text-apple-muted md:text-[1.25rem]">{t('register.description')}</p>
    </div>

    <form data-certified-form class="rounded-[2rem] border border-black/5 bg-white p-5 sm:p-7 md:p-9" novalidate>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        {fields.map((field) => (
          <label class="block">
            <span class="mb-2 block text-sm font-black text-[#050506]">
              {field.label}
              {!field.required && <span class="font-bold text-apple-muted"> · {t('register.optional')}</span>}
            </span>
            <input
              name={field.name}
              type={field.type}
              required={field.required}
              class="w-full rounded-2xl border border-black/10 bg-[#F5F5F7] px-4 py-3.5 text-sm font-semibold text-[#050506] outline-none transition-colors placeholder:text-apple-muted focus:border-[#6F8069] focus:bg-white focus:ring-2 focus:ring-[#8FA58A]/20"
            />
          </label>
        ))}
      </div>

      <label class="mt-4 block">
        <span class="mb-2 block text-sm font-black text-[#050506]">
          {t('register.comments')} <span class="font-bold text-apple-muted"> · {t('register.optional')}</span>
        </span>
        <textarea
          name="comments"
          rows="4"
          class="w-full resize-none rounded-2xl border border-black/10 bg-[#F5F5F7] px-4 py-3.5 text-sm font-semibold text-[#050506] outline-none transition-colors placeholder:text-apple-muted focus:border-[#6F8069] focus:bg-white focus:ring-2 focus:ring-[#8FA58A]/20"
        ></textarea>
      </label>

      <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-center">
        <button
          type="submit"
          data-submit-label={t('register.submit')}
          data-sending-label={t('register.sending')}
          class="inline-flex w-full items-center justify-center rounded-full bg-[#050506] px-7 py-3.5 text-sm font-black text-white transition-colors hover:bg-black/85 disabled:cursor-wait disabled:opacity-70 sm:w-auto"
        >
          {t('register.submit')}
        </button>
        <p data-form-status class="min-h-5 text-sm font-bold text-apple-muted" aria-live="polite"></p>
      </div>
    </form>
  </div>
</section>

<script is:inline define:vars={{ requiredMessage: t('register.required'), successMessage: t('register.success'), errorMessage: t('register.error') }}>
  function setupCertifiedForm() {
    const form = document.querySelector('[data-certified-form]');
    if (!(form instanceof HTMLFormElement) || form.dataset.ready) return;
    form.dataset.ready = 'true';

    const button = form.querySelector('button[type="submit"]');
    const status = form.querySelector('[data-form-status]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(button instanceof HTMLButtonElement) || !(status instanceof HTMLElement)) return;

      if (!form.checkValidity()) {
        form.reportValidity();
        status.textContent = requiredMessage;
        status.className = 'min-h-5 text-sm font-bold text-[#8a5a00]';
        return;
      }

      const formData = Object.fromEntries(new FormData(form).entries());
      button.disabled = true;
      button.textContent = button.dataset.sendingLabel || 'Sending...';
      status.textContent = '';

      try {
        // TODO: Send formData to Firebase/Firestore or a verified purchase storage endpoint.
        void formData;
        await new Promise((resolve) => window.setTimeout(resolve, 650));
        form.reset();
        status.textContent = successMessage;
        status.className = 'min-h-5 text-sm font-bold text-[#2E4F1F]';
      } catch {
        status.textContent = errorMessage;
        status.className = 'min-h-5 text-sm font-bold text-red-600';
      } finally {
        button.disabled = false;
        button.textContent = button.dataset.submitLabel || 'Submit';
      }
    });
  }

  setupCertifiedForm();
  document.addEventListener('astro:page-load', setupCertifiedForm);
</script>
