---
import type { UiLanguage } from '../../i18n/config';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: UiLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang, 'certifiedTech');
const tips = t('care.tips').split('|');
---

<section class="bg-apple-bg px-5 py-24 text-apple-text sm:px-8 sm:py-32">
  <div class="mx-auto max-w-[1120px]">
    <h2 class="max-w-[820px] text-[clamp(2.2rem,5vw,4.5rem)] font-black leading-[0.98] tracking-normal text-[#050506]">{t('care.title')}</h2>
    <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-4">
      {tips.map((tip, index) => (
        <article class="rounded-[1.5rem] border border-black/5 bg-white p-6">
          <p class="mb-8 text-xs font-black text-[#6F8069]">{String(index + 1).padStart(2, '0')}</p>
          <p class="text-[1rem] font-black leading-snug text-[#050506]">{tip}</p>
        </article>
      ))}
    </div>
  </div>
</section>
