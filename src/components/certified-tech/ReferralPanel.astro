---
import type { UiLanguage } from '../../i18n/config';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: UiLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang, 'certifiedTech');
const rewards = t('referral.cards').split('|');
---

<section class="bg-white px-5 py-24 text-apple-text sm:px-8 sm:py-32">
  <div class="mx-auto max-w-[1120px] rounded-[2.5rem] border border-black/5 bg-[#F5F5F7] p-6 sm:p-10 md:p-14">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
      <div>
        <h2 class="text-[clamp(2.2rem,5vw,4.5rem)] font-black leading-[0.98] tracking-normal text-[#050506]">{t('referral.title')}</h2>
        <p class="mt-6 text-[1.08rem] font-medium leading-relaxed text-apple-muted md:text-[1.25rem]">{t('referral.body')}</p>
      </div>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
        {rewards.map((reward) => (
          <div class="rounded-2xl border border-black/5 bg-white p-5">
            <p class="text-sm font-black leading-tight text-[#050506]">{reward}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <a
        data-whatsapp-share
        data-message={t('referral.message')}
        href="#"
        target="_blank"
        rel="noreferrer"
        class="inline-flex w-full items-center justify-center rounded-full bg-[#050506] px-7 py-3.5 text-sm font-black text-white transition-colors hover:bg-black/85 sm:w-auto"
      >
        {t('referral.share')}
      </a>
      <a href="#registro" class="inline-flex w-full items-center justify-center rounded-full border border-black/10 bg-white px-7 py-3.5 text-sm font-black text-[#050506] transition-colors hover:bg-black/[0.04] sm:w-auto">
        {t('referral.register')}
      </a>
    </div>
  </div>
</section>

<script>
  function setupWhatsappShare() {
    document.querySelectorAll('[data-whatsapp-share]').forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) return;
      const message = link.dataset.message || '';
      const currentUrl = window.location.href;
      link.href = `https://wa.me/?text=${encodeURIComponent(`${message} ${currentUrl}`)}`;
    });
  }

  setupWhatsappShare();
  document.addEventListener('astro:page-load', setupWhatsappShare);
</script>
